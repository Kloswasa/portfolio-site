{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tokens:gen": "node --import tsx scripts/tokens/generate.ts",
    "tokens:dtcg": "node --import tsx scripts/tokens/export-dtcg.ts",
    "tokens:sync": "npm run tokens:pull && npm run tokens:gen",
    "tokens:pull": "node --import tsx scripts/figma/export-tokens.ts",
    "content:all": "node --import tsx scripts/case-studies/compile-case-study.ts homhuan busaba kuendee flomax bhaesaj cio bupha jtimber thaihom quiz-game dementia-app recipe block-showcase",
    "content:bhaesaj": "node --import tsx scripts/case-studies/compile-case-study.ts bhaesaj",
    "content:quiz-game": "node --import tsx scripts/case-studies/compile-case-study.ts quiz-game",
    "content:block-showcase": "node --import tsx scripts/case-studies/compile-case-study.ts block-showcase",
    "content:bupha": "node --import tsx scripts/case-studies/compile-case-study.ts bupha",
    "content:busaba": "node --import tsx scripts/case-studies/compile-case-study.ts busaba",
    "content:cio": "node --import tsx scripts/case-studies/compile-case-study.ts cio",
    "content:flomax": "node --import tsx scripts/case-studies/compile-case-study.ts flomax",
    "content:homhuan": "node --import tsx scripts/case-studies/compile-case-study.ts homhuan",
    "content:jtimber": "node --import tsx scripts/case-studies/compile-case-study.ts jtimber",
    "content:kuendee": "node --import tsx scripts/case-studies/compile-case-study.ts kuendee",
    "content:dementia-app": "node --import tsx scripts/case-studies/compile-case-study.ts dementia-app",
    "content:recipe": "node --import tsx scripts/case-studies/compile-case-study.ts recipe",
    "content:thaihom": "node --import tsx scripts/case-studies/compile-case-study.ts thaihom",
    "validate:data": "node --import tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "framer-motion": "^12.23.0",
    "lenis": "^1.3.23",
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "yaml": "^2.9.0"
  }
}
